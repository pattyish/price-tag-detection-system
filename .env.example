# Environment Configuration Template
# Copy this file to .env and update values for your environment

# Model Configuration
YOLO_MODEL=yolov8m
DEVICE=cuda
CONFIDENCE_THRESHOLD=0.5
IOA_THRESHOLD=0.4

# OCR Configuration
OCR_ENGINE=easyocr
OCR_LANGUAGES=en
OCR_GPU=true
OCR_CONFIDENCE=0.5

# Data Configuration
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
TRAIN_SPLIT=0.7
VAL_SPLIT=0.2
TEST_SPLIT=0.1

# Training Configuration
EPOCHS=100
BATCH_SIZE=16
LEARNING_RATE=0.001
DEVICE=cuda
NUM_WORKERS=4

# Inference Configuration
MODEL_PATH=models/weights/best.pt
MAX_DETECTIONS=100

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
MAX_UPLOAD_SIZE=52428800

# Logging Configuration
LOG_DIR=logs
LOG_LEVEL=INFO
ENABLE_JSON_LOGGING=true

# Paths
MODELS_DIR=models
WEIGHTS_DIR=models/weights
RESULTS_DIR=results
